{
  "id": "example.watch-stats",
  "name": "观影计时统计",
  "version": "0.0.1",
  "author": "Iris Examples",
  "description": "外部进程插件示例：记录累计实际播放时长并跨会话持久化，在底栏与侧栏展示统计并注册命令面板动作。",
  "protocol": 1,
  "entry": "main.py",
  "permissions": [
    "read_state",
    "ui_sidebar",
    "ui_status",
    "notifications"
  ],
  "commands": [
    {
      "id": "reset",
      "title": "统计：重置观影计时",
      "subtitle": "将累计播放时长归零"
    }
  ]
}
